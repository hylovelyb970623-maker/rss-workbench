# ===== RSS 工作台配置 =====
# 复制为 .env 后按需修改；所有配置都可以省略

# ----- 数据库（默认 SQLite，一般不用改） -----
# DATABASE_URL=sqlite:///./data/rss.db

# ----- 登录（可选） -----
# 设置密码后，网页和所有 /api 接口都需要登录；留空则完全开放
# APP_PASSWORD=
# token 签名密钥（不填则由密码派生）；多实例部署或改密码不踢人时建议固定一个
# AUTH_SECRET=
# AUTH_TOKEN_TTL_DAYS=7

# ----- RSSHub（rsshub:路由 简写与预置源依赖此配置） -----
# 例如 http://your-rsshub:1200
# RSSHUB_BASE=

# ----- FreshRSS（首次启动预置分类源依赖此配置） -----
# 地址需指向 FreshRSS 的 RSS 输出入口，以 /i/ 结尾
# FRESHRSS_BASE=http://your-freshrss:8088/i/
# FRESHRSS_USER=
# FRESHRSS_TOKEN=

# ----- 抓取 -----
# FETCH_TIMEOUT=10                 # 单个源请求超时（秒）
# FETCH_INTERVAL_MINUTES=15        # 默认抓取间隔（分钟），可在每个源上单独覆盖
# RETENTION_DAYS=30                # 文章保留天数（星标文章不清理）
# FETCH_ALLOW_PRIVATE=false        # RSSHub/FreshRSS 部署在内网时改为 true（放行私网地址）

# ----- LLM（AI 摘要，可选；OpenAI 兼容接口） -----
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# AI_SUMMARY_ENABLED=false         # 定时批量补摘要开关（手动逐篇生成不受此限制）
# AI_SUMMARY_BATCH=5               # 定时任务每轮处理篇数

# ----- 调度 -----
# SCHEDULER_ENABLED=true
# SCHEDULER_FETCH_MINUTES=15       # 到期源自动刷新间隔
# SCHEDULER_CLEANUP_HOUR=4         # 每日文章清理时刻
# SCHEDULER_AI_SUMMARY_MINUTES=30
